{
  "info": {
    "name": "CATC LabTrack \u00b7 Ten HTTP checks",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    }
  ],
  "item": [
    {
      "name": "Setup \u00b7 user session",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/csrf",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "user",
              "type": "string"
            },
            {
              "key": "password",
              "value": "user-demo",
              "type": "string"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"userToken\", pm.response.json().token);",
              "pm.collectionVariables.set(\"userCookie\", pm.response.headers.get(\"Set-Cookie\").split(\";\")[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "Setup \u00b7 admin session",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/csrf",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "admin",
              "type": "string"
            },
            {
              "key": "password",
              "value": "admin-demo",
              "type": "string"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set(\"adminToken\", pm.response.json().token);",
              "pm.collectionVariables.set(\"adminCookie\", pm.response.headers.get(\"Set-Cookie\").split(\";\")[0]);"
            ]
          }
        }
      ]
    },
    {
      "name": "1 \u00b7 Create meter",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/equipment",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "user",
              "type": "string"
            },
            {
              "key": "password",
              "value": "user-demo",
              "type": "string"
            }
          ]
        },
        "header": [
          {
            "key": "Cookie",
            "value": "{{userCookie}}"
          },
          {
            "key": "X-CSRF-TOKEN",
            "value": "{{userToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"assetCode\": \"PM-{{run}}-A\",\n  \"name\": \"Demo meter\",\n  \"location\": \"EE Laboratory\",\n  \"status\": \"AVAILABLE\"\n}"
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"run\", Date.now().toString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Verify response data\", () => { pm.expect(pm.response.json().id).to.be.a(\"number\"); });",
              "pm.collectionVariables.set(\"itemA\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "2 \u00b7 List",
      "protocolProfileBehavior": {
        "disableCookies": true
      },
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/equipment",
        "auth": {
          "type": "basic",
          "basic": [
            {
              "key": "username",
              "value": "user",
              "type": "string"
            },
            {
              "key": "password",
              "value": "user-demo",
              "type": "string"
            }
          ]
        },
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Verify response data\", () => { pm.expect(pm.response.json().map(x => x.id)).to.include(Number(pm.collectionVariables.get(\"itemA\"))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "2 \u00b7 Retrieve meter",
